#include <bits/stdc++.h>
using namespace std;

int Asking(int L,int R) {
    cout << "? " << L << ' ' << R << endl;
    int Golu; cin >> Golu;
    if(Golu < 0) exit(0);
    return Golu;
}
void Faf() {
    int N;cin >> N;
    int Chomu = Asking(1,N);
    bool Yes = Chomu && Asking(1,Chomu) < Chomu;
    cout << "! " << (Yes ? "YES" : "NO") << endl;
}
int main(){
    ios::sync_with_stdio(0);
    cin.tie(0);
    int T;
    cin >> T;
    while(T--) Faf();
}
